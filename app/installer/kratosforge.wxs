<!--
  KratosForge as a per-user MSI, for Intune and Configuration Manager (docs/enterprise-install.md).

  Built by CI (.github/workflows/ci.yml, job shell) with WiX from the same kratosforge.exe the
  release publishes, so the exe in the MSI and the one people download are the same bytes.

  Per user: no administrator rights, nothing in Program Files or HKLM. The exe goes to
  %LOCALAPPDATA%\Programs\KratosForge, with a Start menu shortcut. That folder is the user's, so
  the app can still update itself there; IT that wants to control versions sets
  "auto_update": false and deploys each new MSI instead.

  Never change UpgradeCode: it is how a newer MSI finds and replaces an older one.
  The version comes from the CI run number (0.1.<run>, carrying into the second field past 65535),
  passed in as -d Version=..., so each build upgrades the last.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="KratosForge"
           Manufacturer="KratosBI"
           Version="$(var.Version)"
           UpgradeCode="9b7d27af-a699-475e-a9e3-c3f09833ddda"
           Scope="perUser"
           Compressed="yes"
           Language="1033">
    <SummaryInformation Description="KratosForge desktop app for Microsoft Fabric" />

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer KratosForge is already installed. Uninstall it first to go back to this one." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="KratosForge.ico" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="KratosForge.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://kratosdatagod.github.io/kratosforge/" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="KratosForge" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- A per-user install keys each component on an HKCU value, not on a file. -->
    <Component Id="App" Directory="INSTALLFOLDER" Guid="*">
      <File Id="KratosForgeExe" Source="$(var.ExeFile)" Name="kratosforge.exe" />
      <RegistryValue Root="HKCU" Key="Software\KratosBI\KratosForge" Name="InstallFolder" Type="string"
                     Value="[INSTALLFOLDER]" KeyPath="yes" />
      <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
    </Component>

    <!-- Not advertised, so starting it never triggers an MSI repair (which would undo a self-update). -->
    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="*">
      <Shortcut Id="KratosForgeShortcut" Name="KratosForge" Description="KratosForge for Microsoft Fabric"
                Target="[INSTALLFOLDER]kratosforge.exe" WorkingDirectory="INSTALLFOLDER" Icon="KratosForge.ico" />
      <RegistryValue Root="HKCU" Key="Software\KratosBI\KratosForge" Name="StartMenuShortcut" Type="integer"
                     Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="KratosForge">
      <ComponentRef Id="App" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
