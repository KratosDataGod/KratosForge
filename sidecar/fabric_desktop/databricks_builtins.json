  "group": "databricks:variant",
  "example": "SELECT variant_get(parse_json('{\"key\": 123, \"data\": [4, {\"a\": \"hello\"}, \"str\"]}'), '$.data[1].a', 'string')",
  "value": [
   [
    "hello"
   ]
  ],
  "note": "A cast that turns on a number's exact VARIANT type (a STRING, or a DECIMAL with a fraction, to an integer; a date; a STRUCT) stops by name"
 },
