{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fabric Desktop",
  "version": "0.1.0",
  "identifier": "com.kratosbi.fabricdesktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Fabric Desktop by KratosBI",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "frame-src": "nbout: http://nbout.localhost https://nbout.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "KratosBI",
    "copyright": "Copyright KratosBI"
  }
}
