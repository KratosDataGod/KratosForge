{
    "name": "pl_orders_daily",
    "objectId": "5f0c2a5e-0000-4000-8000-000000000001",
    "properties": {
        "description": "Loads the day's orders into bronze, then silver — façade test ünïcode.",
        "activities": [
            {
                "name": "Get watermark",
                "type": "Lookup",
                "dependsOn": [],
                "policy": {"timeout": "0.12:00:00", "retry": 2, "retryIntervalInSeconds": 30, "secureOutput": false, "secureInput": false},
                "typeProperties": {
                    "source": {"type": "LakehouseTableSource", "timestampAsOf": null},
                    "firstRowOnly": true,
                    "datasetSettings": {
                        "annotations": [],
                        "linkedService": {"name": "LH_Meta", "properties": {"annotations": [], "type": "Lakehouse",
                            "typeProperties": {"workspaceId": "00000000-0000-0000-0000-000000000000", "artifactId": "11111111-1111-1111-1111-111111111111", "rootFolder": "Tables"}}},
                        "type": "LakehouseTable",
                        "schema": [],
                        "typeProperties": {"table": "watermarks"}
                    }
                }
            },
            {
                "name": "List new files",
                "type": "GetMetadata",
                "dependsOn": [{"activity": "Get watermark", "dependencyConditions": ["Succeeded"]}],
                "typeProperties": {
                    "fieldList": ["childItems"],
                    "datasetSettings": {"type": "Binary", "typeProperties": {"location": {"type": "LakehouseLocation",
                        "folderPath": {"value": "@concat('landing/orders/', formatDateTime(pipeline().parameters.run_date, 'yyyy/MM/dd'))", "type": "Expression"}}}}
                }
            },
            {
                "name": "Any files",
                "type": "IfCondition",
                "dependsOn": [{"activity": "List new files", "dependencyConditions": ["Succeeded"]}],
                "userProperties": [{"name": "owner", "value": "sales-data"}],
                "typeProperties": {
                    "expression": {"value": "@greater(length(activity('List new files').output.childItems), 0)", "type": "Expression"},
                    "ifTrueActivities": [
                        {
                            "name": "Each file",
                            "type": "ForEach",
                            "dependsOn": [],
                            "typeProperties": {
                                "items": {"value": "@activity('List new files').output.childItems", "type": "Expression"},
                                "isSequential": false,
                                "batchCount": 4,
                                "activities": [
                                    {
                                        "name": "Copy file to bronze",
                                        "type": "Copy",
                                        "dependsOn": [],
                                        "policy": {"timeout": "0.01:00:00", "retry": 1},
                                        "typeProperties": {
                                            "source": {"type": "BinarySource", "storeSettings": {"type": "LakehouseReadSettings", "recursive": false,
                                                "wildcardFileName": {"value": "@item().name", "type": "Expression"}}},
                                            "sink": {"type": "LakehouseTableSink", "tableActionOption": "Append"},
                                            "enableStaging": false,
                                            "translator": {"type": "TabularTranslator", "typeConversion": true}
                                        }
                                    },
                                    {
                                        "name": "Count files",
                                        "type": "AppendVariable",
                                        "dependsOn": [{"activity": "Copy file to bronze", "dependencyConditions": ["Succeeded"]}],
                                        "typeProperties": {"variableName": "loaded_files", "value": {"value": "@item().name", "type": "Expression"}}
                                    }
                                ]
                            }
                        }
                    ],
                    "ifFalseActivities": [
                        {"name": "Nothing to load", "type": "Wait", "dependsOn": [], "typeProperties": {"waitTimeInSeconds": 1}}
                    ]
                }
            },
            {
                "name": "Bronze to silver",
                "type": "TridentNotebook",
                "dependsOn": [{"activity": "Any files", "dependencyConditions": ["Succeeded"]}],
                "policy": {"timeout": "0.02:00:00", "retry": 0, "retryIntervalInSeconds": 30, "secureOutput": false, "secureInput": false},
                "typeProperties": {
                    "notebookId": "22222222-2222-2222-2222-222222222222",
                    "workspaceId": "00000000-0000-0000-0000-000000000000",
                    "parameters": {
                        "run_date": {"value": {"value": "@pipeline().parameters.run_date", "type": "Expression"}, "type": "string"},
                        "files": {"value": {"value": "@string(variables('loaded_files'))", "type": "Expression"}, "type": "string"}
                    },
                    "sessionTag": "orders"
                },
                "externalReferences": {"connection": "33333333-3333-3333-3333-333333333333"}
            },
            {
                "name": "Pick region job",
                "type": "Switch",
                "dependsOn": [{"activity": "Bronze to silver", "dependencyConditions": ["Succeeded"]}],
                "typeProperties": {
                    "on": {"value": "@pipeline().parameters.region", "type": "Expression"},
                    "cases": [
                        {"value": "emea", "activities": [
                            {"name": "Refresh EMEA", "type": "InvokePipeline", "dependsOn": [],
                             "typeProperties": {"operationType": "InvokeFabricPipeline", "pipelineId": "44444444-4444-4444-4444-444444444444",
                                 "workspaceId": "00000000-0000-0000-0000-000000000000", "waitOnCompletion": true,
                                 "parameters": {"day": {"value": "@pipeline().parameters.run_date", "type": "Expression"}}},
                             "externalReferences": {"connection": "55555555-5555-5555-5555-555555555555"}}
                        ]},
                        {"value": "amer", "activities": [
                            {"name": "Run AMER script", "type": "Script", "dependsOn": [],
                             "linkedService": {"name": "WH_Sales", "properties": {"type": "DataWarehouse"}},
                             "typeProperties": {"scripts": [{"type": "Query", "text": "SELECT COUNT(*) AS n FROM dbo.orders WHERE region = 'amer'"}],
                                 "scriptBlockExecutionTimeout": "02:00:00"}}
                        ]}
                    ],
                    "defaultActivities": [
                        {"name": "Unknown region", "type": "Fail", "dependsOn": [],
                         "typeProperties": {"message": {"value": "@concat('No job for region ', pipeline().parameters.region)", "type": "Expression"}, "errorCode": "400"}}
                    ]
                }
            },
            {
                "name": "Wait for silver",
                "type": "Until",
                "dependsOn": [{"activity": "Bronze to silver", "dependencyConditions": ["Succeeded"]}],
                "typeProperties": {
                    "expression": {"value": "@equals(activity('Check silver').output.status, 'ready')", "type": "Expression"},
                    "timeout": "0.01:00:00",
                    "activities": [
                        {"name": "Check silver", "type": "WebActivity", "dependsOn": [],
                         "typeProperties": {"method": "GET", "relativeUrl": "status/@{pipeline().parameters.run_date}",
                             "headers": {"x-run": "@{pipeline().RunId}"}},
                         "externalReferences": {"connection": "66666666-6666-6666-6666-666666666666"}},
                        {"name": "Pause", "type": "Wait", "dependsOn": [{"activity": "Check silver", "dependencyConditions": ["Succeeded"]}],
                         "typeProperties": {"waitTimeInSeconds": 60}}
                    ]
                }
            },
            {
                "name": "Record success",
                "type": "SetVariable",
                "dependsOn": [
                    {"activity": "Pick region job", "dependencyConditions": ["Succeeded"]},
                    {"activity": "Wait for silver", "dependencyConditions": ["Succeeded", "Skipped"]}
                ],
                "policy": {"secureOutput": false, "secureInput": false},
                "typeProperties": {"variableName": "status", "value": "ok"}
            },
            {
                "name": "Return files",
                "type": "SetVariable",
                "dependsOn": [{"activity": "Record success", "dependencyConditions": ["Completed"]}],
                "typeProperties": {"variableName": "pipelineReturnValue", "setSystemVariable": true,
                    "value": [{"key": "files", "value": {"type": "Expression", "content": "@variables('loaded_files')"}}]}
            },
            {
                "name": "Alert on failure",
                "type": "ContosoPagerNotify",
                "dependsOn": [{"activity": "Bronze to silver", "dependencyConditions": ["Failed"]}],
                "state": "Inactive",
                "onInactiveMarkAs": "Succeeded",
                "typeProperties": {"severity": 2, "futureSetting": {"nested": [1, 2.50, true, null]}},
                "x-contoso-trace": "kept"
            }
        ],
        "parameters": {
            "run_date": {"type": "string", "defaultValue": "2026-10-17"},
            "region": {"type": "string", "defaultValue": "emea"},
            "api_key": {"type": "securestring", "defaultValue": "not-a-real-secret"}
        },
        "variables": {
            "loaded_files": {"type": "Array", "defaultValue": []},
            "status": {"type": "String"}
        },
        "annotations": ["orders", "daily"],
        "concurrency": 1,
        "folder": {"name": "sales/orders"},
        "lastModifiedByObjectId": "77777777-7777-7777-7777-777777777777",
        "lastPublishTime": "2026-10-01T08:00:00Z",
        "x-future-pipeline-setting": {"enabled": true}
    }
}
