  "questions": [
    {
      "id": "4.3-q1",
      "type": "single",
      "stem": "Which trigger starts a job when new files land in a Unity Catalog volume or external location?",
      "options": [
        {
          "id": "a",
          "text": "Manual"
        },
        {
          "id": "b",
          "text": "Continuous"
        },
        {
          "id": "c",
          "text": "Scheduled"
        },
        {
          "id": "d",
          "text": "File arrival"
        }
      ],
      "answer": [
        "d"
      ],
      "explanation": "A file arrival trigger watches a storage location governed by Unity Catalog and starts a run when new files arrive.",
      "source": "https://docs.databricks.com/aws/en/jobs/file-arrival-triggers",
      "version": 1,
      "status": "live",
      "reviewed": "2026-11-03"
    },
    {
      "id": "4.3-q2",
      "type": "single",
      "stem": "Which trigger starts a job when a source table it reads is updated?",
      "options": [
        {
          "id": "a",
          "text": "Table update"
        },
        {
          "id": "b",
          "text": "Continuous"
        },
        {
          "id": "c",
          "text": "Scheduled"
        },
        {
          "id": "d",
          "text": "File arrival"
        }
      ],
      "answer": [
        "a"
      ],
      "explanation": "A table update trigger runs the job when the Unity Catalog tables it watches are updated.",
      "source": "https://docs.databricks.com/aws/en/jobs/trigger-table-update",
      "version": 1,
      "status": "live",
      "reviewed": "2026-11-03"
    },
    {
      "id": "4.3-q3",
      "type": "single",
      "stem": "A report job must run at 06:00 every weekday. Which trigger fits?",
      "options": [
        {
          "id": "a",
          "text": "Continuous"
        },
        {
          "id": "b",
          "text": "Scheduled, with a cron-style schedule"
        },
        {
          "id": "c",
          "text": "Table update"
        },
        {
          "id": "d",
          "text": "File arrival"
        }
      ],
      "answer": [
        "b"
      ],
      "explanation": "A scheduled trigger runs the job on a time-based schedule, which you can edit in Quartz cron syntax.",
      "source": "https://docs.databricks.com/aws/en/jobs/scheduled",
      "version": 1,
      "status": "live",
      "reviewed": "2026-11-03"
