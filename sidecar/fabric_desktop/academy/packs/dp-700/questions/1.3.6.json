  "questions": [
    {
      "id": "1.3.6-q1",
      "type": "multiple",
      "stem": "Which three are kinds of endorsement in Fabric? Each correct answer is a complete solution.",
      "options": [
        {
          "id": "a",
          "text": "Archived"
        },
        {
          "id": "b",
          "text": "Certified"
        },
        {
          "id": "c",
          "text": "Promoted"
        },
        {
          "id": "d",
          "text": "Encrypted"
        },
        {
          "id": "e",
          "text": "Master data"
        }
      ],
      "answer": [
        "c",
        "b",
        "e"
      ],
      "explanation": "Items can be endorsed as Promoted, Certified or Master data.",
      "source": "https://learn.microsoft.com/en-us/fabric/governance/endorsement-overview",
      "version": 1,
      "status": "live",
      "reviewed": "2026-11-03"
    },
    {
      "id": "1.3.6-q2",
      "type": "single",
      "stem": "Who can mark an item as Certified?",
      "options": [
        {
          "id": "a",
          "text": "Only the item's creator"
        },
        {
          "id": "b",
          "text": "Anyone with a Pro license"
        },
        {
          "id": "c",
          "text": "Anyone who can view the item"
        },
        {
          "id": "d",
          "text": "Users a Fabric administrator has authorized to certify"
        }
      ],
      "answer": [
        "d"
      ],
      "explanation": "Certification is controlled: Fabric admins choose who can certify. Promotion is open to people with write permission on the item.",
      "source": "https://learn.microsoft.com/en-us/fabric/governance/endorsement-overview",
      "version": 1,
      "status": "live",
      "reviewed": "2026-11-03"
    },
    {
      "id": "1.3.6-q3",
      "type": "single",
      "stem": "What does a Master data endorsement tell people about an item?",
      "options": [
        {
          "id": "a",
          "text": "It holds core, single-source-of-truth data, such as the customer list"
        },
        {
          "id": "b",
          "text": "It has passed a deployment pipeline"
        },
        {
          "id": "c",
          "text": "It is the newest item in the workspace"
        },
        {
          "id": "d",
          "text": "It is encrypted"
        }
      ],
      "answer": [
        "a"
      ],
      "explanation": "Master data marks items whose data is the authoritative source for core business entities.",
      "source": "https://learn.microsoft.com/en-us/fabric/governance/endorsement-overview",
      "version": 1,
      "status": "live",
      "reviewed": "2026-11-03"
    },
    {
      "id": "1.3.6-q4",
      "type": "single",
      "stem": "Why endorse items?",
      "options": [
        {
          "id": "a",
          "text": "To turn on Git integration"
        },
        {
          "id": "b",
          "text": "To give everyone edit access"
        },
        {
          "id": "c",
          "text": "So people can find trusted, quality content more easily"
        },
        {
          "id": "d",
          "text": "To reduce capacity use"
        }
      ],
      "answer": [
        "c"
      ],
      "explanation": "Endorsement badges show which items are trustworthy, and people can find endorsed items in places such as the OneLake catalog.",
      "source": "https://learn.microsoft.com/en-us/fabric/governance/endorsement-overview",
      "version": 1,
      "status": "live",
      "reviewed": "2026-11-03"
    }
  ]
}
