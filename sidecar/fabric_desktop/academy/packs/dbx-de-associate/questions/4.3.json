    {
      "id": "4.3-q4",
      "type": "single",
      "stem": "A job should start a new run as soon as the previous run ends, so that it always keeps running. Which trigger fits?",
      "options": [
        {
          "id": "a",
          "text": "Continuous"
        },
        {
          "id": "b",
          "text": "File arrival"
        },
        {
          "id": "c",
          "text": "Manual"
        },
        {
          "id": "d",
          "text": "Scheduled every minute"
        }
      ],
      "answer": [
        "a"
      ],
      "explanation": "A continuous trigger keeps one run active, starting a new run when the previous one finishes.",
      "source": "https://docs.databricks.com/aws/en/jobs/triggers",
      "version": 1,
      "status": "live",
      "reviewed": "2026-11-03"
    },
    {
      "id": "4.3-q5",
      "type": "single",
      "stem": "Fernhill's files land in a volume at uneven times. Which trigger avoids both idle runs and long waits?",
      "options": [
        {
          "id": "a",
          "text": "File arrival on the volume"
        },
        {
          "id": "b",
          "text": "Scheduled every 24 hours"
        },
        {
          "id": "c",
          "text": "Continuous on a fixed cluster"
        },
        {
          "id": "d",
          "text": "Manual"
        }
      ],
      "answer": [
        "a"
      ],
      "explanation": "A file arrival trigger reacts when files land, so the job runs only when there is new data.",
