{
  "schema": "kratosforge/academy-question@1",
  "objective": "1.3.1",
  "questions": [
    {
      "id": "1.3.1-q1",
      "type": "single",
      "stem": "At Harbor Health, which workspace role gives the engineers what they need with the least privilege?",
      "options": [
        {
          "id": "a",
          "text": "Admin"
        },
        {
          "id": "b",
          "text": "Member"
        },
        {
          "id": "c",
          "text": "Contributor"
        },
        {
          "id": "d",
          "text": "Viewer"
        }
      ],
      "answer": [
        "c"
      ],
      "explanation": "Contributors can create, edit and delete items but can't manage access. Members can also share and add people, and Admins can do everything, which is more than the engineers need.",
      "source": "https://learn.microsoft.com/en-us/fabric/fundamentals/roles-workspaces",
      "case": "harbor-analytics",
      "version": 1,
      "status": "live",
      "reviewed": "2026-11-03"
    },
    {
      "id": "1.3.1-q2",
      "type": "single",
      "stem": "Which is the only workspace role that can delete the workspace?",
      "options": [
        {
          "id": "a",
          "text": "Member"
        },
        {
          "id": "b",
          "text": "Viewer"
        },
        {
          "id": "c",
          "text": "Contributor"
        },
        {
          "id": "d",
          "text": "Admin"
        }
      ],
      "answer": [
        "d"
      ],
      "explanation": "Only Admins can delete the workspace and add or remove other Admins.",
      "source": "https://learn.microsoft.com/en-us/fabric/fundamentals/roles-workspaces",
      "version": 1,
      "status": "live",
      "reviewed": "2026-11-03"
    },
    {
      "id": "1.3.1-q3",
      "type": "single",
      "stem": "A user must view the workspace's content but change nothing. Which workspace role fits?",
      "options": [
        {
          "id": "a",
          "text": "Contributor"
        },
        {
          "id": "b",
          "text": "Admin"
        },
        {
          "id": "c",
          "text": "Viewer"
        },
        {
          "id": "d",
          "text": "Member"
        }
      ],
      "answer": [
        "c"
      ],
      "explanation": "Viewers can see and use content without editing it.",
      "source": "https://learn.microsoft.com/en-us/fabric/fundamentals/roles-workspaces",
      "version": 1,
      "status": "live",
      "reviewed": "2026-11-03"
    },
    {
      "id": "1.3.1-q4",
      "type": "multiple",
      "stem": "Which three can be given a Fabric workspace role? Each correct answer is a complete solution.",
      "options": [
        {
          "id": "a",
          "text": "A Microsoft 365 group"
        },
        {
          "id": "b",
          "text": "A lakehouse"
        },
        {
          "id": "c",
          "text": "A Power BI report"
        },
        {
          "id": "d",
          "text": "An individual user"
        },
        {
          "id": "e",
          "text": "A Microsoft Entra security group"
        }
      ],
      "answer": [
        "d",
        "e",
        "a"
      ],
      "explanation": "Workspace roles are assigned to users and groups, including security groups and Microsoft 365 groups. Items can't hold workspace roles.",
      "source": "https://learn.microsoft.com/en-us/fabric/fundamentals/roles-workspaces",
      "version": 1,
      "status": "live",
      "reviewed": "2026-11-03"
    }
  ]
}
